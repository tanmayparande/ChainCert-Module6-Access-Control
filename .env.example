# Example configuration for Module 6. Copy to .env (git-ignored) or export
# these in your shell. This module does not read .env files itself.

# Separate SQLite database for Module 6 only (never the main ChainCert DB).
M6_DATABASE_PATH=instance/module6_access_control.db

# Absolute session lifetime in minutes.
M6_SESSION_TTL_MINUTES=60

# Minimum password length for new accounts.
M6_PASSWORD_MIN_LENGTH=12

# Allow anonymous (not logged-in) public certificate verification.
M6_ALLOW_ANONYMOUS_VERIFICATION=true

# Optional secret (>= 16 chars). If set, session-token hashes use HMAC-SHA256.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it invalidates all existing sessions.
M6_SESSION_TOKEN_PEPPER=

# Argon2id cost parameters (defaults shown).
M6_ARGON2_TIME_COST=3
M6_ARGON2_MEMORY_COST=65536
M6_ARGON2_PARALLELISM=4
